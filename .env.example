# --- CycladesGo portal -------------------------------------------------------
# The domain is NOT yet purchased. cycladesgo.com is the intended apex; the
# build falls back to a placeholder so preview deployments never emit a
# canonical pointing at a domain we do not control.
#
# NEVER commit a real production value here. Copy to .env.local and set it there.
SITE_URL=https://cycladesgo.com

# Identity used for the imprint / imprint block. Filled in at go-live — see
# docs/legal.md §P0-2. Placeholders are deliberately obvious so an unfilled
# field cannot be mistaken for a real legal identity.
CYCLADESGO_LEGAL_NAME=
CYCLADESGO_ADDRESS=
CYCLADESGO_EMAIL=
CYCLADESGO_VAT=
CYCLADESGO_GEMI=
