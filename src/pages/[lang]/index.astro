---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import DomeBadge from '../../components/ui/DomeBadge.astro';
import TrustBanner from '../../components/TrustBanner.astro';
import { ISLANDS, PLANNED } from '../../data/islands';
import { SITE } from '../../data/site';
import { useTranslations } from '../../i18n/ui';
import { LOCALES, localeUrl } from '../../i18n/utils';
import { islandListNode, organizationNode, websiteNode } from '../../lib/jsonld';
import { publishedLocalesFor, resolveLocale } from '../../lib/page';

export const getStaticPaths: GetStaticPaths = () => LOCALES.map((lang) => ({ params: { lang } }));

const locale = resolveLocale(Astro.params.lang);
const t = useTranslations(locale);
const path = '/';
const hreflangLocales = publishedLocalesFor(path);

const totals = ISLANDS.reduce(
  (acc, i) => ({
    stops: acc.stops + (i.counts?.stops ?? 0),
    lines: acc.lines + (i.counts?.lines ?? 0),
    journeys: acc.journeys + (i.counts?.journeys ?? 0),
  }),
  { stops: 0, lines: 0, journeys: 0 },
);

const jsonLd = [organizationNode(), websiteNode(), islandListNode()];
---

<BaseLayout
  title={SITE.name}
  description="Free, offline bus journey planners for Naxos, Paros, Santorini, Milos and Ios. Operators' own published timetables, honest estimates, no tracking. Unofficial."
  locale={locale}
  pathname={localeUrl(locale, path)}
  hreflangLocales={hreflangLocales}
  jsonLd={jsonLd}
>
  <div class="shell-wide py-6">
    <!-- Masthead: the engine's eyebrow + H1 + trailing rule + lede. -->
    <section class="mb-6">
      <p class="eyebrow">{t('hero.eyebrow')}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-[var(--color-ink)]">
        {t('hero.title')}
        <span class="rule" aria-hidden="true"></span>
      </h1>
      <p class="mt-3 max-w-prose text-[var(--color-ink-soft)]">{t('hero.lede')}</p>
      <p class="mt-2 max-w-prose text-[var(--color-ink-soft)]">{t('hero.lede2')}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        <Button href={localeUrl(locale, '/islands')} size="lg" variant="primary">
          {t('hero.ctaPrimary')}
          <Icon name="arrow" size={18} />
        </Button>
        <Button href={localeUrl(locale, '/data/methodology')} size="lg" variant="secondary">
          {t('hero.ctaSecondary')}
        </Button>
      </div>
    </section>

    <!-- What we publish, as a list the way the engine lists routes. -->
    <section class="mb-8">
      <SectionHeading
        stripe="aegean"
        size="lg"
        href={localeUrl(locale, '/islands')}
        action={t('common.readMore')}
      >
        {t('islands.title')}
      </SectionHeading>
      <ul class="flex flex-col gap-2">
        {
          ISLANDS.map((island) => (
            <li>
              <a
                href={`${island.currentUrl}/en/`}
                rel="noopener"
                class="flex items-center gap-3 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 shadow-[var(--shadow-cube)] transition hover:shadow-[var(--shadow-lift)] no-underline"
              >
                <DomeBadge line={String(island.counts?.lines ?? 0)} color={island.accent} />
                <div class="min-w-0 flex-1">
                  <p class="truncate font-semibold text-[var(--color-ink)]">
                    {island.brand}{' '}
                    <span class="hidden font-normal text-[var(--color-muted)] sm:inline">
                      — {island.name} (<span lang="el">{island.nameEl}</span>)
                    </span>
                  </p>
                  <p class="truncate text-xs text-[var(--color-muted)]">
                    <span class="sm:hidden">
                      {island.name} (<span lang="el">{island.nameEl}</span>) ·
                    </span>
                    {island.counts?.stops} {t('islands.stops')} · {island.counts?.journeys}{' '}
                    {t('islands.journeys')} · {island.operator.name}
                  </p>
                </div>
                {island.dataValidTo && (
                  <span class="tabular hidden shrink-0 rounded-[var(--radius-sm)] bg-[var(--color-sun-bg)] px-2 py-0.5 text-xs font-medium text-[var(--color-sun-ink)] sm:inline">
                    {t('islands.validTo')} {island.dataValidTo.slice(5)}
                  </span>
                )}
                <Icon name="chevron" size={16} class="-rotate-90 shrink-0 text-[var(--color-muted)]" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <TrustBanner locale={locale} class="mb-8" />

    <!-- Counts, as the engine's departure board: mono numerals, plain labels. -->
    <section class="mb-8">
      <SectionHeading stripe="sea" size="lg">{t('data.title')}</SectionHeading>
      <dl class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        {
          [
            { value: ISLANDS.length, label: t('hero.stat1'), color: 'var(--color-aegean)' },
            { value: totals.lines, label: t('hero.stat2'), color: 'var(--color-line-2)' },
            { value: totals.stops, label: t('hero.stat3'), color: 'var(--color-line-5)' },
            { value: totals.journeys, label: t('hero.stat4'), color: 'var(--color-sea)' },
          ].map((stat) => (
            <Card>
              <dt class="text-[0.7rem] font-semibold uppercase tracking-wide text-[var(--color-muted)]">
                {stat.label}
              </dt>
              <dd
                class="tabular mt-1 text-2xl font-semibold"
                style={`color:${stat.color}`}
              >
                {stat.value}
              </dd>
            </Card>
          ))
        }
      </dl>
      <p class="mt-3 text-xs leading-relaxed text-[var(--color-muted)]">
        Every count is read from the engine dataset, never typed by hand. If a dataset expires, this
        site stops publishing rather than showing you a stale number.
      </p>
    </section>

    <!-- Why it exists -->
    <section class="mb-8">
      <SectionHeading stripe="terracotta" size="lg">{t('network.title')}</SectionHeading>
      <p class="max-w-prose text-[var(--color-ink-soft)]">{t('network.lede')}</p>
      <ul class="mt-4 grid gap-2 sm:grid-cols-3">
        {
          [
            {
              icon: 'download',
              title: 'It installs and it stays',
              body: 'The planner is a PWA. Install it once on the bus or on the ferry and it opens without a signal.',
              href: '/data/methodology',
              link: t('data.methodology'),
              color: 'var(--color-aegean)',
            },
            {
              icon: 'clock',
              title: 'It tells you the last bus',
              body: 'Every line page shows the first and last service of the day, and what happens after that.',
              href: '/network',
              link: t('nav.network'),
              color: 'var(--color-sun)',
            },
            {
              icon: 'shield',
              title: 'It never pretends to be live',
              body: 'Every time is the operator’s published schedule, labelled with the date it was retrieved.',
              href: '/data/quality',
              link: t('data.quality'),
              color: 'var(--color-olive)',
            },
          ].map((item) => (
            <li>
              <Card class="h-full">
                <span
                  class="inline-flex h-9 w-9 items-center justify-center rounded-[var(--radius-md)]"
                  style={`background:var(--color-surface-2);color:${item.color}`}
                >
                  <Icon name={item.icon as 'download'} size={18} />
                </span>
                <h3 class="mt-3 font-semibold text-[var(--color-ink)]">{item.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-soft)]">{item.body}</p>
                <a
                  href={localeUrl(locale, item.href)}
                  class="mt-3 inline-flex items-center gap-0.5 text-xs font-semibold text-[var(--brand)] no-underline hover:underline"
                >
                  {item.link}
                  <Icon name="chevron" size={14} class="-rotate-90" />
                </a>
              </Card>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Not yet covered -->
    <section class="mb-6">
      <SectionHeading stripe="muted" as="h2">{t('islands.plannedTitle')}</SectionHeading>
      <p class="max-w-prose text-sm text-[var(--color-ink-soft)]">{t('islands.plannedLede')}</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          PLANNED.map((island) => (
            <li class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1.5 text-xs text-[var(--color-muted)]">
              {island.name} <span lang="el">{island.nameEl}</span>
            </li>
          ))
        }
      </ul>
      <div class="mt-4">
        <Button href={localeUrl(locale, '/report')} variant="secondary" size="sm">
          {t('islands.reportSource')}
          <Icon name="arrow" size={15} />
        </Button>
      </div>
    </section>
  </div>
</BaseLayout>
