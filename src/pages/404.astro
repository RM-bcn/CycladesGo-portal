---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { ISLANDS } from '../data/islands';
import { useTranslations } from '../i18n/ui';
import { DEFAULT_LOCALE, localeUrl } from '../i18n/utils';

/*
 * Site-wide 404. It sits outside `[lang]/`, so there is no `Astro.params.lang`
 * to resolve: the locale is hardcoded to English and the page is noindex with an
 * empty hreflang cluster, because a not-found page must never join a language
 * group or a translation cluster for content that does not exist.
 */
const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);
const pathname = '/404';

const sections = [
  { href: '/islands', key: 'nav.islands', note: 'The five island planners' },
  { href: '/network', key: 'nav.network', note: 'How island buses actually work' },
  { href: '/data', key: 'nav.data', note: 'Sources, known limits, changelog' },
  { href: '/about', key: 'nav.about', note: 'Who builds this' },
  { href: '/sponsors', key: 'nav.sponsors', note: 'What sponsorship buys' },
  { href: '/report', key: 'footer.report', note: 'A wrong time or a timetable source' },
];
---

<BaseLayout
  title="Page not found"
  description="That page does not exist. Search, or jump to the island planners, the data pages, or the homepage."
  locale={locale}
  pathname={pathname}
  hreflangLocales={[]}
  noindex
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="tabular text-sm font-semibold uppercase tracking-wide text-[var(--color-muted)]">
      404
    </p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-4xl" style="letter-spacing: -0.03em;">
      This page does not exist
    </h1>
    <p class="prose-measure mt-3 text-lg leading-relaxed text-[var(--color-ink-soft)]">
      The address you followed is not here. That is usually a mistyped link or an old page that has
      moved. Nothing is broken on your side, and nothing about the planner is affected: each island
      planner is a separate site and works on its own.
    </p>

    <div class="mt-10">
      <form
        role="search"
        action="https://duckduckgo.com/"
        method="get"
        class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 shadow-[var(--shadow-cube)]"
      >
        <label for="site-search" class="block text-sm font-semibold text-[var(--color-ink)]">
          Search for a page on this site
        </label>
        <p id="site-search-hint" class="mt-1 text-xs leading-relaxed text-[var(--color-muted)]">
          There is no search index on this site, because an offline-first project has nowhere to put
          one. This sends the search to an external engine, restricted to cycladesgo.com.
        </p>
        <div class="mt-3 flex flex-col gap-2 sm:flex-row">
          <input
            type="search"
            id="site-search"
            name="q"
            aria-describedby="site-search-hint"
            autocomplete="off"
            class="w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2.5 text-sm text-[var(--color-ink)]"
          />
          <input type="hidden" name="sites" value="cycladesgo.com" />
          <button
            type="submit"
            class="inline-flex shrink-0 items-center justify-center gap-2 rounded-[var(--radius-md)] bg-[var(--color-aegean)] px-5 py-2.5 text-sm font-semibold text-[var(--color-aegean-btn-text)] no-underline transition-colors hover:bg-[var(--color-aegean-btn-hover)]"
          >
            Search
            <Icon name="arrow" size={15} />
          </button>
        </div>
      </form>
    </div>

    <nav aria-label="Sections of this site" class="mt-10">
      <h2 class="text-xl font-semibold tracking-tight text-[var(--color-ink)]" style="letter-spacing: -0.02em;">
        Where to go instead
      </h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          sections.map((section) => (
            <li>
              <a
                href={localeUrl(locale, section.href)}
                class="group flex h-full items-start gap-3 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] p-4 no-underline transition-colors hover:border-[var(--color-aegean)] hover:bg-[var(--color-aegean-bg)]"
              >
                <Icon
                  name="arrow"
                  size={16}
                  class="mt-1 shrink-0 text-[var(--color-aegean)]"
                />
                <span>
                  <span class="block text-sm font-semibold text-[var(--color-ink)]">
                    {t(section.key)}
                  </span>
                  <span class="mt-0.5 block text-sm text-[var(--color-muted)]">{section.note}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section aria-labelledby="notfound-islands" class="mt-12">
      <h2 id="notfound-islands" class="text-xl font-semibold tracking-tight text-[var(--color-ink)]" style="letter-spacing: -0.02em;">
        Or pick an island
      </h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          ISLANDS.map((island) => (
            <li>
              <a
                href={`${island.currentUrl}/en/`}
                rel="noopener"
                class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3.5 py-2 text-sm text-[var(--color-ink-soft)] no-underline transition-colors hover:border-[var(--color-aegean)] hover:text-[var(--color-aegean-deep)]"
              >
                {island.brand}
                <Icon name="external" size={13} />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-12 flex flex-wrap gap-3">
      <a
        href={localeUrl(locale, '/')}
        class="inline-flex items-center gap-2 rounded-[var(--radius-md)] bg-[var(--color-aegean)] px-5 py-3 text-sm font-semibold text-[var(--color-aegean-btn-text)] no-underline transition-colors hover:bg-[var(--color-aegean-btn-hover)]"
      >
        {t('common.backHome')}
        <Icon name="arrow" size={16} />
      </a>
      <a
        href={localeUrl(locale, '/islands')}
        class="inline-flex items-center gap-2 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-3 text-sm font-semibold text-[var(--color-ink-soft)] no-underline transition-colors hover:bg-[var(--color-surface-2)]"
      >
        {t('nav.islands')}
      </a>
    </div>
  </div>
</BaseLayout>
