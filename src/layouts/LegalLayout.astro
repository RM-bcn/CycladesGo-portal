---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE } from '../data/site';
import { useTranslations } from '../i18n/ui';
import { localeUrl, type Locale } from '../i18n/utils';
import { breadcrumbNode, organizationNode } from '../lib/jsonld';
import { publishedLocalesFor } from '../lib/page';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  dateModified: string;
  icon: 'shield' | 'database' | 'clock' | 'globe';
}

const { title, description, locale, path, dateModified, icon } = Astro.props;
const t = useTranslations(locale);
const hreflangLocales = publishedLocalesFor(path);

const sections = [
  { href: '/legal', key: 'legal.imprintTitle' },
  { href: '/legal/privacy', key: 'legal.privacyTitle' },
  { href: '/legal/cookies', key: 'legal.cookiesTitle' },
  { href: '/legal/terms', key: 'legal.termsTitle' },
  { href: '/legal/accessibility', key: 'legal.accessTitle' },
] as const;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  pathname={localeUrl(locale, path)}
  hreflangLocales={hreflangLocales}
  dateModified={dateModified}
  jsonLd={[
    organizationNode(),
    breadcrumbNode([
      { name: 'Home', path: '/' },
      { name: 'Legal', path: '/legal' },
      { name: title, path },
    ]),
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6 text-xs text-[var(--color-muted)]">
      <a href={localeUrl(locale, '/')} class="no-underline hover:underline">Home</a>
      <span aria-hidden="true"> / </span>
      <a href={localeUrl(locale, '/legal')} class="no-underline hover:underline">{t('legal.title')}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{title}</span>
    </nav>

    <div class="grid gap-10 lg:grid-cols-[220px_1fr]">
      <nav aria-label="Legal sections" class="lg:sticky lg:top-24 lg:self-start">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-[var(--color-muted)]">
          {t('legal.title')}
        </h2>
        <ul class="mt-3 space-y-1">
          {
            sections.map((section) => (
              <li>
                <a
                  href={localeUrl(locale, section.href)}
                  aria-current={localeUrl(locale, section.href) === localeUrl(locale, path) ? 'page' : undefined}
                  class:list={[
                    'block rounded-[var(--radius-sm)] px-3 py-2 text-sm no-underline',
                    localeUrl(locale, section.href) === localeUrl(locale, path)
                      ? 'bg-[var(--color-aegean-bg)] font-semibold text-[var(--color-aegean-deep)]'
                      : 'text-[var(--color-ink-soft)] hover:bg-[var(--color-surface-2)]',
                  ]}
                >
                  {t(section.key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <article class="min-w-0">
        <div class="flex items-center gap-3">
          <span
            class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-aegean-bg)] text-[var(--color-aegean-deep)]"
          >
            <Icon name={icon} size={22} />
          </span>
          <div>
            <h1 class="text-3xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-4xl" style="letter-spacing: -0.03em;">
              {title}
            </h1>
            <p class="mt-1 text-xs text-[var(--color-muted)]">
              {t('legal.updated')}: <time datetime={dateModified} class="tabular">{dateModified}</time>
            </p>
          </div>
        </div>

        <div class="doc prose-measure mt-8">
          <slot />
        </div>

        <p class="mt-10 border-t border-[var(--color-border)] pt-6 text-xs leading-relaxed text-[var(--color-muted)]">
          Questions about this page: <a class="underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
          The English text is the authoritative version; other languages may lag.
        </p>
      </article>
    </div>
  </div>
</BaseLayout>
