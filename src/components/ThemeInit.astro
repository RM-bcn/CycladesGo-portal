---
/**
 * Resolves the theme before first paint so the Aegean Night tokens never flash
 * white. Identical approach to the engine's ThemeInit; the portal is a separate
 * deployable and cannot import it.
 */
const script = `(function(){try{var s=localStorage.getItem('cg-theme');var m=window.matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.setAttribute('data-theme',s==='light'||s==='dark'?s:(m?'dark':'light'));}catch(e){document.documentElement.setAttribute('data-theme','light');}})();`;
---
<script is:inline set:html={script} />
