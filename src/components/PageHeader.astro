---
/**
 * The page masthead, built from the engine's home-page hero:
 *
 *   <p class="tabular text-xs font-medium uppercase tracking-[0.2em]">operator</p>
 *   <h1 class="mt-2 text-4xl font-bold tracking-tight">Title
 *     <span class="inline-block h-[3px] w-12 rounded-[2px] bg-aegean" /></h1>
 *   <p class="mt-3 max-w-prose text-ink-soft">lede</p>
 *
 * The eyebrow and the trailing bar are the parts that make the engine's pages
 * recognisable at a glance, and they were missing entirely from the first
 * version of the portal.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  class?: string;
}

const { eyebrow, title, lede, class: className = '' } = Astro.props;
---

<section class={`mb-6 ${className}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-2 text-4xl font-bold tracking-tight text-[var(--color-ink)]">
    {title}
    <span class="rule" aria-hidden="true"></span>
  </h1>
  {lede && <p class="mt-3 max-w-prose text-[var(--color-ink-soft)]">{lede}</p>}
</section>
