---
import Logo from './Logo.astro';
import Icon from './ui/Icon.astro';
import { SITE } from '../data/site';
import { useTranslations } from '../i18n/ui';
import { LOCALE_NAMES, localeUrl, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  pathname: string;
}
const { locale, pathname } = Astro.props;
const t = useTranslations(locale);

const nav = [
  { href: '/islands', key: 'nav.islands' },
  { href: '/network', key: 'nav.network' },
  { href: '/data', key: 'nav.data' },
  { href: '/about', key: 'nav.about' },
] as const;

const href = (path: string) => localeUrl(locale, path);
const isActive = (path: string) => pathname === href(path) || pathname.startsWith(`${href(path)}/`);
---

<header
  class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/92 backdrop-blur supports-[backdrop-filter]:bg-[var(--color-bg)]/80"
>
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:px-6">
    <a href={href('/')} class="no-underline" aria-label={`${SITE.name} — ${t('nav.home')}`}>
      <Logo size={26} />
    </a>

    <nav aria-label="Main" class="ml-auto hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-[var(--radius-sm)] px-3 py-2 text-sm font-medium no-underline transition-colors',
              isActive(item.href)
                ? 'bg-[var(--color-aegean-bg)] text-[var(--color-aegean-deep)]'
                : 'text-[var(--color-ink-soft)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-ink)]',
            ]}
          >
            {t(item.key)}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5 md:ml-0">
      <details class="relative hidden sm:block">
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--color-border)] px-2.5 py-1.5 text-xs font-medium text-[var(--color-ink-soft)] hover:bg-[var(--color-surface-2)]"
        >
          <Icon name="globe" size={14} />
          {LOCALE_NAMES[locale].endonym}
        </summary>
        <ul
          class="absolute right-0 z-50 mt-1 w-36 overflow-hidden rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] py-1 shadow-[var(--shadow-lift)]"
        >
          {
            Object.entries(LOCALE_NAMES).map(([code, name]) => (
              <li>
                <a
                  href={localeUrl(code as Locale, pathname.replace(/^\/(en|el|de|fr|it)(?=\/|$)/, '') || '/')}
                  lang={name.hreflang}
                  hreflang={name.hreflang}
                  aria-current={code === locale ? 'true' : undefined}
                  class:list={[
                    'block px-3 py-2 text-sm no-underline',
                    code === locale
                      ? 'bg-[var(--color-aegean-bg)] font-semibold text-[var(--color-aegean-deep)]'
                      : 'text-[var(--color-ink-soft)] hover:bg-[var(--color-surface-2)]',
                  ]}
                >
                  {name.endonym}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <button
        type="button"
        data-theme-toggle
        aria-label={t('nav.theme')}
        class="flex items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--color-border)] px-2.5 py-1.5 text-xs font-medium text-[var(--color-ink-soft)] hover:bg-[var(--color-surface-2)]"
      >
        <span class="hidden sm:inline dark:hidden"><Icon name="moon" size={14} /></span>
        <span class="hidden dark:inline sm:inline"><Icon name="sun" size={14} /></span>
      </button>
    </div>
  </div>

  <nav aria-label="Main (compact)" class="flex gap-1 overflow-x-auto border-t border-[var(--color-border)] px-4 py-1.5 md:hidden">
    {
      nav.map((item) => (
        <a
          href={href(item.href)}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'shrink-0 rounded-[var(--radius-sm)] px-2.5 py-1.5 text-[13px] font-medium no-underline',
            isActive(item.href)
              ? 'bg-[var(--color-aegean-bg)] text-[var(--color-aegean-deep)]'
              : 'text-[var(--color-ink-soft)]',
          ]}
        >
          {t(item.key)}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const btn = document.querySelector('[data-theme-toggle]');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('cg-theme', next);
    } catch {}
  });
</script>
