---
interface Props {
  as?: 'div' | 'section' | 'article' | 'li';
  class?: string;
  padded?: boolean;
}
const { as: Tag = 'div', class: className = '', padded = true } = Astro.props;
---

<Tag
  class={`rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[var(--shadow-cube)] ${padded ? 'p-5' : ''} ${className}`}
>
  <slot />
</Tag>
