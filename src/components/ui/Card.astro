---
/**
 * Ported from the engine's `src/components/ui/Card.astro`. The engine uses
 * radius-md and p-4; the first version of this portal used radius-lg and p-6,
 * which is the single clearest sign it had been designed as a separate product.
 */
interface Props {
  class?: string;
  href?: string;
  padding?: boolean;
  /** Wrapper element. An extension over the engine's Card, which hardcodes a
   *  div, needed so a card can be an <article> or a <section> and be announced
   *  as one. */
  as?: 'div' | 'section' | 'article' | 'li';
}

const { class: className = '', href, padding = true, as: Tag = 'div' } = Astro.props;
const classes = `card ${padding ? 'p-4' : ''} ${className}`;
---

{
  href ? (
    <a href={href} class={`group block transition hover:shadow-[var(--shadow-lift)] ${classes}`}>
      <slot />
    </a>
  ) : (
    <Tag class={classes}>
      <slot />
    </Tag>
  )
}
