---
/**
 * CycladesGo wordmark. Text-only wordmark plus a geometric mark — no operator
 * logos anywhere on this site, because a nominative-use defence for a logo is
 * far weaker than for a plain name (see docs/legal.md §trademarks).
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2 ${className}`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    role="img"
    aria-label="CycladesGo"
    class="shrink-0"
  >
    <rect width="32" height="32" rx="8" fill="var(--color-aegean)" />
    <path
      d="M5 20.5C5 13.6 10.1 8 16.4 8c4.6 0 8.5 3 10.1 7.2"
      stroke="#FAF7F2"
      stroke-width="2.4"
      stroke-linecap="round"
    />
    <circle cx="10.4" cy="21.4" r="2.6" fill="#FAF7F2" />
    <circle cx="20.8" cy="21.4" r="2.6" fill="#FAF7F2" />
    <path d="M5 25.6h22" stroke="#FAF7F2" stroke-width="2.4" stroke-linecap="round" />
  </svg>
  <span class="font-semibold tracking-tight text-[var(--color-ink)]">CycladesGo</span>
</span>
