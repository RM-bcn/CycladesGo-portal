---
import Icon from './ui/Icon.astro';
import { ISLANDS } from '../data/islands';
import { SITE } from '../data/site';
import { useTranslations } from '../i18n/ui';
import { localeUrl, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const href = (path: string) => localeUrl(locale, path);

const legalLinks = [
  { href: '/legal', key: 'footer.imprint' },
  { href: '/legal/privacy', key: 'footer.privacy' },
  { href: '/legal/terms', key: 'footer.terms' },
  { href: '/legal/cookies', key: 'footer.cookies' },
  { href: '/legal/accessibility', key: 'footer.accessibility' },
] as const;

const year = new Date().getFullYear();
---

<footer class="mt-12 border-t border-[var(--color-border)] bg-[var(--color-surface-2)]">
  <div class="shell-wide py-10">
    <nav aria-labelledby="footer-islands" class="mb-8">
      <p id="footer-islands" class="mb-2 text-[0.7rem] font-semibold uppercase tracking-wide text-[var(--color-muted)]">
        {t('nav.islands')}
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          ISLANDS.map((island) => (
            <li>
              <a
                href={`${island.currentUrl}/en/`}
                rel="noopener"
                class="inline-flex items-center gap-1.5 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1.5 text-sm no-underline transition hover:bg-[var(--color-surface-2)]"
              >
                <Icon name="pin" size={15} class="text-[var(--color-aegean)]" />
                {island.brand}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={href('/islands')}
            class="inline-flex items-center gap-1.5 rounded-[var(--radius-md)] px-3 py-1.5 text-sm font-medium text-[var(--color-aegean)] no-underline hover:underline"
          >
            {t('islands.title')}
            <Icon name="chevron" size={14} class="-rotate-90" />
          </a>
        </li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-legal">
      <p id="footer-legal" class="mb-2 text-[0.7rem] font-semibold uppercase tracking-wide text-[var(--color-muted)]">
        {t('footer.legal')}
      </p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1.5">
        {
          legalLinks.map((link) => (
            <li>
              <a href={href(link.href)} class="text-sm text-[var(--color-ink-soft)] no-underline hover:underline">
                {t(link.key)}
              </a>
            </li>
          ))
        }
        <li>
          <a href={href('/data/methodology')} class="text-sm text-[var(--color-ink-soft)] no-underline hover:underline">
            {t('footer.methodology')}
          </a>
        </li>
        <li>
          <a href={href('/report')} class="text-sm text-[var(--color-ink-soft)] no-underline hover:underline">
            {t('footer.report')}
          </a>
        </li>
        <li>
          <a href="/llms.txt" class="text-sm text-[var(--color-ink-soft)] no-underline hover:underline">
            llms.txt
          </a>
        </li>
        <li>
          <a href={href('/sponsors')} class="text-sm text-[var(--color-ink-soft)] no-underline hover:underline">
            {t('footer.donations')}
          </a>
        </li>
      </ul>
    </nav>

    <!--
      PD 131/2003 Art. 4(1) requires name, address and contact to be "easily,
      directly and continuously accessible". That is why the imprint is in the
      footer of every page and not only on /legal. Placeholder values render as
      visibly pending so an unfilled field can never be mistaken for a real legal
      identity.
    -->
    <div class="mt-8 border-t border-[var(--color-border)] pt-6 text-xs leading-relaxed text-[var(--color-muted)]">
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <Icon name="shield" size={14} class="shrink-0" />
        {t('footer.rights')}
      </p>
      <p class="mt-3">
        <strong class="font-semibold text-[var(--color-ink-soft)]">{t('footer.imprint')}:</strong>{' '}
        {SITE.legalName} · {SITE.address} ·{' '}
        <a class="underline" href={`mailto:${SITE.email}`}>{SITE.email}</a> · VAT {SITE.vat} · GEMI{' '}
        {SITE.gemi}
      </p>
      <p class="mt-3">
        <strong class="font-semibold text-[var(--color-ink-soft)]">{t('legal.disclaimerTitle')}:</strong>{' '}
        CycladesGo is an independent commercial project. It is not affiliated with, endorsed by,
        authorised by or operated by KTEL Naxos, KTEL Paros, KTEL Cyclades, Milos Buses or any other
        bus or ferry operator, and it is not a ticket sales office. Operator names appear solely to
        identify who runs each service. We publish schedules, not live departures.
      </p>
      <p class="mt-3">{t('footer.attribution')}</p>
      <p class="mt-3">
        © {year} {SITE.legalName} ·{' '}
        <a class="underline" href={SITE.repo} rel="noopener">{SITE.repo}</a>
      </p>
    </div>
  </div>
</footer>
